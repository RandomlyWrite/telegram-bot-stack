# Copy to .env for local only. Never commit real values.
# On Railway: set these as Variables instead.

BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...   # either name is fine; pick one and stick to it

# Webhook mode (recommended on Railway)
MODE=webhook
WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# Railway injects PORT and RAILWAY_PUBLIC_DOMAIN automatically

# Supabase (optional)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only
SUPABASE_ANON_KEY=eyJ...           # only if Mini App needs it
